# Proposed delta only. Not applied to the flight controller.
# Verify on ground before use. VIO timestamps represent image capture time.
# Vehicle-Id Component-Id Name Value Type
1	1	EKF2_EV_DELAY	0.000000000000000000	9
# Coarse user measurement: D435i IMU is 15 cm forward and 2 cm above CG.
# FRD: forward +X, right +Y, down +Z. Compensation is only in PX4.
1	1	EKF2_EV_POS_X	0.150000000000000000	9
1	1	EKF2_EV_POS_Y	0.000000000000000000	9
1	1	EKF2_EV_POS_Z	-0.020000000000000000	9
# Use barometric reference while evaluating visual vertical drift/loss.
1	1	EKF2_HGT_REF	0	6
# Enable stick override in both automatic and Offboard modes.
1	1	COM_RC_OVERRIDE	3	6
