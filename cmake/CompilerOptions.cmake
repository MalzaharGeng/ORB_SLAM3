# Shared by ORB_SLAM3, DBoW2 and g2o. Never force optimization into Debug.
add_compile_options($<$<COMPILE_LANG_AND_ID:C,GNU,Clang>:-Wall>
                    $<$<COMPILE_LANG_AND_ID:CXX,GNU,Clang>:-Wall>)
if(ORB_SLAM3_NATIVE_ARCH)
    if(CMAKE_CROSSCOMPILING)
        message(FATAL_ERROR "ORB_SLAM3_NATIVE_ARCH requires a native build; select the target CPU in your toolchain")
    endif()
    if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
        set(_orb_native_flag "-mcpu=native")
    else()
        set(_orb_native_flag "-march=native")
    endif()
    include(CheckCXXCompilerFlag)
    check_cxx_compiler_flag("${_orb_native_flag}" ORB_SLAM3_NATIVE_FLAG_SUPPORTED)
    if(NOT ORB_SLAM3_NATIVE_FLAG_SUPPORTED)
        message(FATAL_ERROR "Compiler does not support ${_orb_native_flag}; disable ORB_SLAM3_NATIVE_ARCH")
    endif()
    add_compile_options("$<$<AND:$<OR:$<CONFIG:Release>,$<CONFIG:RelWithDebInfo>>,$<COMPILE_LANGUAGE:C,CXX>>:${_orb_native_flag}>")
endif()
